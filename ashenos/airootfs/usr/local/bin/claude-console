#!/usr/bin/env bash
# Кнопка Claude: если окно уже есть — прячет/показывает его, иначе открывает приложение Claude
# (claude-desk). С --terminal открывает Claude Code в терминале, как раньше.
# Рабочая папка: первый аргумент или ~/claude
MARK=claude

state=$(swaymsg -t get_tree | jq -r --arg m "$MARK" '
  .. | objects | select(.type=="workspace") | .name as $ws
  | .. | objects | select((.marks // []) | index($m))
  | "\($ws) \(.focused)"' | head -n1)

if [ -n "$state" ]; then
  read -r ws focused <<<"$state"
  if [ "$ws" = "__i3_scratch" ]; then
    swaymsg "[con_mark=$MARK] scratchpad show, floating disable, focus" >/dev/null
  elif [ "$focused" = "true" ]; then
    swaymsg "[con_mark=$MARK] move scratchpad" >/dev/null
  else
    swaymsg "[con_mark=$MARK] focus" >/dev/null
  fi
  exit 0
fi

if [ "$1" != "--terminal" ] && [ -f "$HOME/.local/share/claude-desk/shell.qml" ]; then
  quickshell -p "$HOME/.local/share/claude-desk/shell.qml" >/dev/null 2>&1 &
  pid=$!
  for _ in $(seq 80); do
    swaymsg "[pid=$pid] mark --add $MARK" >/dev/null 2>&1 && break
    sleep 0.1
  done
  wait $pid
  exit 0
fi
[ "$1" = "--terminal" ] && shift

DIR="${1:-$HOME/claude}"
[ -d "$DIR" ] || DIR="$HOME"
CMD='claude; echo; echo "Claude завершился. Enter — закрыть."; read'
if command -v konsole >/dev/null; then
  konsole --workdir "$DIR" -p tabtitle=Claude -e bash -lc "$CMD" &
elif command -v kitty >/dev/null; then
  kitty --directory "$DIR" --title Claude bash -lc "$CMD" &
else
  exit 1
fi
pid=$!
# Ставим метку, как только окно появится
for _ in $(seq 50); do
  swaymsg "[pid=$pid] mark --add $MARK" >/dev/null 2>&1 && break
  sleep 0.1
done
wait $pid
