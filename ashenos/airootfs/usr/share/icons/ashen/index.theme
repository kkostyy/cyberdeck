[Icon Theme]
Name=Ashen
Comment=Пепельно-чёрные объёмные значки AshenOS (поверх Breeze Dark)
Inherits=breeze-dark,hicolor
Directories=256x256/apps,256x256/places
Example=system-file-manager

[256x256/apps]
Size=256
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[256x256/places]
Size=256
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
